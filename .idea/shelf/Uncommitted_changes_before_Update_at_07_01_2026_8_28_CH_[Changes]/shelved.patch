         android:textSize=\"16sp\"\r\n                    android:textStyle=\"bold\"\r\n                    android:textColor=\"@color/wine_dark_background\"/>\r\n\r\n                <LinearLayout\r\n                    android:layout_width=\"match_parent\"\r\n                    android:layout_height=\"wrap_content\"\r\n                    android:orientation=\"horizontal\"\r\n                    android:layout_marginTop=\"4dp\">\r\n\r\n                    <TextView\r\n                        android:id=\"@+id/tv_nearest_store_distance\"\r\n                        android:layout_width=\"wrap_content\"\r\n                        android:layout_height=\"wrap_content\"\r\n                        android:text=\"\uD83D\uDCCD 0 km\"\r\n                        android:textSize=\"13sp\"\r\n                        android:textColor=\"@color/wine_neutral_dark\"/>\r\n\r\n                    <TextView\r\n                        android:layout_width=\"wrap_content\"\r\n                        android:layout_height=\"wrap_content\"\r\n                        android:text=\"  •  \"\r\n                        android:textColor=\"@color/wine_neutral_dark\"/>\r\n\r\n                    <TextView\r\n                        android:id=\"@+id/tv_nearest_store_duration\"\r\n                        android:layout_width=\"wrap_content\"\r\n                        android:layout_height=\"wrap_content\"\r\n                        android:text=\"\uD83D\uDD50 0 phút\"\r\n                        android:textSize=\"13sp\"\r\n                        android:textColor=\"@color/wine_neutral_dark\"/>\r\n\r\n                </LinearLayout>\r\n\r\n                <com.google.android.material.button.MaterialButton\r\n                    android:id=\"@+id/btn_select_nearest_store\"\r\n                    android:layout_width=\"match_parent\"\r\n                    android:layout_height=\"36dp\"\r\n                    android:layout_marginTop=\"8dp\"\r\n                    android:text=\"Chọn quán này\"