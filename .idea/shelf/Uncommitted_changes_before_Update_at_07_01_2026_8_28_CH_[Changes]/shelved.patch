                   android:id=\"@+id/tv_map_title\"\r\n                    android:layout_width=\"wrap_content\"\r\n                    android:layout_height=\"wrap_content\"\r\n                    android:text=\"Bản đồ\"\r\n                    android:textStyle=\"bold\"\r\n                    android:textSize=\"18sp\"\r\n                    android:layout_marginHorizontal=\"16dp\"\r\n                    android:layout_marginBottom=\"8dp\"\r\n                    android:textColor=\"@color/wine_dark_background\"/>\r\n\r\n                <androidx.cardview.widget.CardView\r\n                    android:id=\"@+id/card_map_container\"\r\n                    android:layout_width=\"match_parent\"\r\n                    android:layout_height=\"400dp\"\r\n                    android:layout_marginHorizontal=\"16dp\"\r\n                    android:layout_marginBottom=\"24dp\"\r\n                    app:cardCornerRadius=\"16dp\"\r\n                    app:cardElevation=\"2dp\">\r\n                    \r\n                    <RelativeLayout\r\n                        android:layout_width=\"match_parent\"\r\n                        android:layout_height=\"match_parent\">\r\n\r\n                        <fragment\r\n                            android:id=\"@+id/map\"\r\n                            android:name=\"com.google.android.gms.maps.SupportMapFragment\"\r\n                            android:layout_width=\"match_parent\"\r\n                            android:layout_height=\"match_parent\" />\r\n\r\n                        <!-- Zoom Buttons -->\r\n                        <LinearLayout\r\n                            android:layout_width=\"wrap_content\"\r\n                            android:layout_height=\"wrap_content\"\r\n                            android:orientation=\"vertical\"\r\n                            android:layout_alignParentEnd=\"true\"\r\n                            android:layout_centerVertical=\"true\"\r\n                            android:layout_marginEnd=\"12dp\">\r\n\r\n                            <ImageButton\r\n                                android:id=\"@+id/btn_my_location\"\r\n                                android:layout_width=\"40dp\"\r\n                                android:layout_height=\"40dp\"\r\n                                android:layout_marginBottom=\"8dp\"\r\n                                android:background=\"@drawable/bg_circle_white\"\r\n                                android:src=\"@drawable/ic_my_location\"\r\n                                android:elevation=\"4dp\"\r\n                                app:tint=\"@color/wine_primary\"\r\n                                android:contentDescription=\"Vị trí của tôi\" />\r\n\r\n                            <ImageButton\r\n                                android:id=\"@+id/btn_zoom_in\"\r\n                                android:layout_width=\"40dp\"\r\n                                android:layout_height=\"40dp\"\r\n                                android:layout_marginBottom=\"8dp\"\r\n                                android:background=\"@drawable/bg_circle_white\"\r\n                                android:src=\"@drawable/ic_add\"\r\n                                android:elevation=\"4dp\"\r\n                                app:tint=\"@color/wine_primary\"\r\n                                android:contentDescription=\"Zoom In\" />\r\n\r\n                            <ImageButton\r\n                                android:id=\"@+id/btn_zoom_out\"\r\n                                android:layout_width=\"40dp\"\r\n                                android:layout_height=\"40dp\"\r\n                                android:background=\"@drawable/bg_circle_white\"\r\n                                android:src=\"@drawable/ic_remove\"\r\n                                android:elevation=\"4dp\"\r\n                                app:tint=\"@color/wine_primary\"\r\n                                android:contentDescription=\"Zoom Out\" />\r\n                        </LinearLayout>\r\n\r\n                    </RelativeLayout>\r\n                        \r\n                </androidx.cardview.widget.CardView>\r\n\r\n            </LinearLayout>\r\n        </androidx.core.widget.NestedScrollView>\r\n\r\n        <!-- Selected Branch Info (Hidden by default) -->\r\n        <com.google.android.material.card.MaterialCardView\r\n            android:id=\"@+id/card_branch_info\"\r\n            android:layout_width=\"match_parent\"\r\n            android:layout_height=\"wrap_content\"\r\n            android:layout_margin=\"16dp\"\r\n            app:cardCornerRadius=\"16dp\"\r\n            app:cardElevation=\"8dp\"\r\n            android:visibility=\"gone\">\r\n\r\n            <LinearLayout\r\n                android:layout_width=\"match_parent\"\r\n                android:layout_height=\"wrap_content\"\r\n                android:orientation=\"vertical\"\r\n                android:padding=\"16dp\">\r\n\r\n                <TextView\r\n                    android:id=\"@+id/tv_branch_name\"\r\n                    android:layout_width=\"wrap_content\"\r\n                    android:layout_height=\"wrap_content\"\r\n                    android:text=\"Tên Chi Nhánh\"\r\n                    android:textSize=\"18sp\"\r\n                    android:textStyle=\"bold\"\r\n                    android:textColor=\"@color/wine_dark_background\" />\r\n\r\n                <TextView\r\n                    android:id=\"@+id/tv_branch_address\"\r\n                    android:layout_width=\"wrap_content\"\r\n                    android:layout_height=\"wrap_content\"\r\n                    android:layout_marginTop=\"4dp\"\r\n                    android:text=\"Địa chỉ chi nhánh\"\r\n                    android:textSize=\"14sp\"\r\n                    android:textColor=\"@color/wine_neutral_dark\" />\r\n\r\n                <TextView\r\n                    android:id=\"@+id/tv_distance\"\r\n                    android:layout_width=\"wrap_content\"\r\n                    android:layout_height=\"wrap_content\"\r\n                    android:layout_marginTop=\"8dp\"\r\n                    android:text=\"Cách bạn: 0.0 km\"\r\n                    android:textSize=\"14sp\"\r\n                    android:textStyle=\"bold\"\r\n                    android:textColor=\"@color/wine_primary\" />\r\n\r\n                <com.google.android.material.button.MaterialButton\r\n                    android:id=\"@+id/btn_set_default_branch\"\r\n                    android:layout_width=\"match_parent\"\r\n                    android:layout_height=\"wrap_content\"\r\n                    android:layout_marginTop=\"16dp\"\r\n                    android:text=\"Chọn chi nhánh này\"\r\n                    app:backgroundTint=\"@color/wine_primary\" />\r\n\r\n            </LinearLayout>\r\n        </com.google.android.material.card.MaterialCardView>\r\n\r\n    </LinearLayout>\r\n    \r\n    <!-- Loading Progress -->\r\n    <ProgressBar\r\n        android:id=\"@+id/progress_bar\"\r\n        android:layout_width=\"wrap_content\"\r\n        android:layout_height=\"wrap_content\"\r\n        android:layout_gravity=\"center\"\r\n        android:visibility=\"gone\" />\r\n\r\n</androidx.coordinatorlayout.widget.CoordinatorLayout>
