<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp"
    app:cardBackgroundColor="@color/wine_light_surface"
    app:rippleColor="@color/wine_neutral_light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Row 1: Order ID, Date, Status -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_order_id"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="#123"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/wine_primary" />

            <TextView
                android:id="@+id/tv_order_date"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="01/12 14:30"
                android:textSize="12sp"
                android:textColor="@color/wine_neutral_dark" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_status"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:text="Chờ"
                android:textSize="10sp"
                app:chipMinHeight="24dp"
                app:chipMinTouchTargetSize="24dp"
                app:chipCornerRadius="12dp"
                app:chipStartPadding="8dp"
                app:chipEndPadding="8dp" />
        </LinearLayout>

        <!-- Row 2: Customer, Store, Type, Total -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_customer_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Nguyễn Văn A"
                android:textSize="13sp"
                android:textColor="@color/wine_dark_background"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tv_store_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Quận 1"
                android:textSize="11sp"
                android:textColor="@color/wine_neutral_dark"
                android:maxLines="1"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/tv_order_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🚚"
                android:textSize="14sp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/tv_total"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="150K"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/wine_primary" />
        </LinearLayout>

        <!-- Row 3: Action Buttons -->
        <LinearLayout
            android:id="@+id/layout_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:gravity="end"
            android:visibility="visible" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
