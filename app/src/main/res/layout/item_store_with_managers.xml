<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/wine_light_surface"
    app:strokeWidth="1dp"
    app:strokeColor="@color/wine_neutral_light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header: Store Name and Status -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tv_store_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_toStartOf="@+id/chip_store_status"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Houjicha - Quận 1"
                android:textSize="16sp"
                android:textColor="@color/wine_dark_background"
                android:textStyle="bold" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_store_status"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginStart="8dp"
                android:text="Hoạt động"
                app:chipBackgroundColor="@color/success" />
        </RelativeLayout>

        <!-- Address -->
        <TextView
            android:id="@+id/tv_store_address"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:drawableStart="@android:drawable/ic_dialog_map"
            android:drawablePadding="8dp"
            android:drawableTint="@color/wine_neutral_dark"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="123 Đường ABC"
            android:textSize="13sp"
            android:textColor="@color/wine_neutral_dark" />

        <!-- Contact Info -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_store_phone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:drawableStart="@android:drawable/ic_menu_call"
                android:drawablePadding="8dp"
                android:drawableTint="@color/wine_neutral_dark"
                android:gravity="center_vertical"
                android:text="0123 456 789"
                android:textSize="13sp"
                android:textColor="@color/wine_dark_background" />

            <TextView
                android:id="@+id/tv_store_hours"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableStart="@android:drawable/ic_menu_recent_history"
                android:drawablePadding="8dp"
                android:drawableTint="@color/wine_neutral_dark"
                android:gravity="center_vertical"
                android:text="8:00 - 22:00"
                android:textSize="13sp"
                android:textColor="@color/wine_dark_background" />
        </LinearLayout>

        <com.google.android.material.divider.MaterialDivider
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp" />

        <!-- Managers Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="👔 Người quản lý"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/wine_dark_background"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tv_no_manager"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Chưa có người quản lý"
            android:textSize="13sp"
            android:textColor="@color/wine_neutral_dark"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/layout_managers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
