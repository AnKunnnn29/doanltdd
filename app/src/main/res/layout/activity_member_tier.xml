<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white">

    <!-- Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/wine_primary"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="Hạng Thành Viên"
        app:titleTextColor="@color/white" />

    <!-- Loading View -->
    <FrameLayout
        android:id="@+id/loadingView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center" />

    </FrameLayout>

    <!-- Content View -->
    <ScrollView
        android:id="@+id/contentView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Current Tier Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardCurrentTier"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="8dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:gravity="center">

                    <!-- Tier Badge -->
                    <ImageView
                        android:id="@+id/ivTierBadge"
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:src="@drawable/ic_tier_bronze"
                        android:contentDescription="Tier Badge" />

                    <!-- Tier Name -->
                    <TextView
                        android:id="@+id/tvTierName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Hạng Đồng"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        android:textColor="@color/wine_primary" />

                    <!-- Description -->
                    <TextView
                        android:id="@+id/tvTierDescription"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Hạng khởi đầu - Tích điểm để nâng hạng!"
                        android:textSize="14sp"
                        android:textColor="@color/gray"
                        android:gravity="center" />

                    <!-- Points -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Điểm hiện tại"
                                android:textSize="12sp"
                                android:textColor="@color/gray" />

                            <TextView
                                android:id="@+id/tvCurrentPoints"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0 điểm"
                                android:textSize="24sp"
                                android:textStyle="bold"
                                android:textColor="@color/wine_primary" />

                        </LinearLayout>

                    </LinearLayout>

                    <!-- Progress to next tier -->
                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progressTier"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        app:trackThickness="8dp"
                        app:trackCornerRadius="4dp"
                        app:indicatorColor="@color/wine_primary"
                        app:trackColor="@color/light_gray" />

                    <TextView
                        android:id="@+id/tvPointsToNext"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Còn 50 điểm để lên hạng Bạc"
                        android:textSize="13sp"
                        android:textColor="@color/gray" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Benefits Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Quyền lợi của bạn"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="12dp" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:id="@+id/llBenefitsList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp" />

            </androidx.cardview.widget.CardView>

            <!-- All Tiers Progress -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lộ trình thăng hạng"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="12dp" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:id="@+id/llTierProgress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp" />

            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </ScrollView>

</LinearLayout>
