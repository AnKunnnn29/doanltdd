<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/welcomeRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/splash_gradient_bg">

    <!-- Floating particles container -->
    <FrameLayout
        android:id="@+id/particlesContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <!-- Decorative circles - giống trang Start -->
    <View
        android:id="@+id/decorCircle1"
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="-100dp"
        android:layout_marginEnd="-100dp"
        android:background="@drawable/logo_circle_bg"
        android:alpha="0.1"/>

    <View
        android:id="@+id/decorCircle2"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_gravity="bottom|start"
        android:layout_marginBottom="-50dp"
        android:layout_marginStart="-50dp"
        android:background="@drawable/logo_circle_bg"
        android:alpha="0.1"/>

    <!-- Content Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp">

        <!-- Logo Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <!-- Logo with effects - giống trang Start -->
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="32dp">

                <!-- Shadow circle - giống Start -->
                <View
                    android:id="@+id/logoOuterGlow"
                    android:layout_width="210dp"
                    android:layout_height="210dp"
                    android:layout_gravity="center"
                    android:background="@drawable/logo_circle_bg"
                    android:alpha="0.3"
                    android:translationY="8dp"/>

                <!-- Logo card -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/logoCard"
                    android:layout_width="200dp"
                    android:layout_height="200dp"
                    android:layout_gravity="center"
                    app:cardCornerRadius="100dp"
                    app:cardElevation="16dp"
                    app:cardBackgroundColor="@color/wine_light_surface"
                    android:alpha="0"
                    android:scaleX="0.5"
                    android:scaleY="0.5">

                    <ImageView
                        android:id="@+id/logoImage"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="App Logo"
                        android:src="@drawable/icon"
                        android:scaleType="centerCrop"/>
                </androidx.cardview.widget.CardView>

                <!-- Shimmer overlay -->
                <View
                    android:id="@+id/logoShimmer"
                    android:layout_width="200dp"
                    android:layout_height="200dp"
                    android:layout_gravity="center"
                    android:background="@drawable/welcome_shimmer"
                    android:alpha="0"
                    android:translationX="-250dp"/>
            </FrameLayout>

            <!-- App name -->
            <TextView
                android:id="@+id/tvAppName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Houjicha"
                android:textSize="42sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="12dp"
                android:alpha="0"
                android:translationY="30dp"/>

            <!-- Tagline -->
            <TextView
                android:id="@+id/tvTagline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Trà rang đậm vị"
                android:textSize="18sp"
                android:textColor="#FFFFFF"
                android:alpha="0.9"
                android:translationY="30dp"
                android:gravity="center"/>

        </LinearLayout>

        <!-- Buttons Section -->
        <LinearLayout
            android:id="@+id/buttonsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="32dp"
            android:alpha="0"
            android:translationY="50dp">

            <!-- Login Button - giống style nút Start -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_welcome_login"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:text="ĐĂNG NHẬP"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#8B4513"
                android:backgroundTint="#FFFFFF"
                app:cornerRadius="32dp"
                app:elevation="8dp"
                app:rippleColor="#CD853F"
                android:layout_marginBottom="16dp"/>

            <!-- Register Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_welcome_register"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:text="ĐĂNG KÝ"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                app:strokeColor="#FFFFFF"
                app:strokeWidth="2dp"
                android:backgroundTint="@android:color/transparent"
                app:cornerRadius="32dp"
                app:rippleColor="#FFFFFF"
                android:layout_marginBottom="16dp"/>

            <!-- Guest Mode -->
            <TextView
                android:id="@+id/text_guest_mode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="Tiếp tục với tư cách khách"
                android:textColor="#FFFFFF"
                android:alpha="0.8"
                android:textSize="16sp"
                android:padding="12dp"
                android:clickable="true"
                android:focusable="true"/>

        </LinearLayout>

    </LinearLayout>

    <!-- Bottom branding - giống trang Start -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="16dp"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Powered by"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:alpha="0.6"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Houjicha © 2025"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:alpha="0.8"/>
    </LinearLayout>

</FrameLayout>
