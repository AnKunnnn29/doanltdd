<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/colorBackground"
    tools:context=".Activities.SettingsActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar_settings"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:title="Cài đặt"
        app:navigationIcon="@drawable/ic_arrow_back" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Thông tin quản lý (chỉ hiển thị cho MANAGER/ADMIN) -->
            <LinearLayout
                android:id="@+id/layout_manager_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/TextAppearance.Material3.LabelLarge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="👤 Thông tin quản lý"
                    android:textColor="?attr/colorPrimary"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"/>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/tv_role_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Vai trò:"
                            android:textSize="14sp"
                            android:textColor="?android:attr/textColorSecondary"/>

                        <TextView
                            android:id="@+id/tv_role_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Manager"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorPrimary"
                            android:paddingBottom="12dp"/>

                        <TextView
                            android:id="@+id/tv_stores_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🏪 Cửa hàng quản lý:"
                            android:textSize="14sp"
                            android:textColor="?android:attr/textColorSecondary"/>

                        <TextView
                            android:id="@+id/tv_managed_stores"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Đang tải..."
                            android:textSize="15sp"
                            android:paddingTop="4dp"/>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.divider.MaterialDivider
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="16dp"/>

            </LinearLayout>

            <TextView
                style="@style/TextAppearance.Material3.LabelLarge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Giao diện"
                android:textColor="?attr/colorPrimary"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"/>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switch_dark_mode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Chế độ tối"
                android:textSize="18sp"
                android:padding="16dp"/>

            <com.google.android.material.divider.MaterialDivider
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"/>

            <TextView
                style="@style/TextAppearance.Material3.LabelLarge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bảo mật"
                android:textColor="?attr/colorPrimary"
                android:paddingBottom="8dp"/>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switch_biometric"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Đăng nhập bằng vân tay"
                android:textSize="18sp"
                android:padding="16dp"/>

            <com.google.android.material.divider.MaterialDivider
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"/>

            <TextView
                style="@style/TextAppearance.Material3.LabelLarge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Thông báo"
                android:textColor="?attr/colorPrimary"
                android:paddingBottom="8dp"/>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switch_notifications"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nhận thông báo đẩy"
                android:textSize="18sp"
                android:padding="16dp"/>

            <com.google.android.material.divider.MaterialDivider
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"/>

            <!-- Hiệu ứng theo mùa -->
            <TextView
                style="@style/TextAppearance.Material3.LabelLarge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hiệu ứng"
                android:textColor="?attr/colorPrimary"
                android:paddingBottom="8dp"/>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switch_seasonal_effects"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Hiệu ứng theo mùa"
                android:textSize="18sp"
                android:padding="16dp"/>
            
            <!-- Chế độ chọn mùa -->
            <LinearLayout
                android:id="@+id/layout_season_mode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp">
                
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Chế độ hiệu ứng"
                    android:textSize="14sp"
                    android:textColor="?android:attr/textColorSecondary"
                    android:paddingBottom="8dp"/>
                
                <RadioGroup
                    android:id="@+id/radio_group_season_mode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    
                    <RadioButton
                        android:id="@+id/radio_realtime"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🕐 Theo thời gian thực"
                        android:textSize="16sp"
                        android:padding="8dp"/>
                    
                    <RadioButton
                        android:id="@+id/radio_custom"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🎨 Tự chọn hiệu ứng"
                        android:textSize="16sp"
                        android:padding="8dp"/>
                </RadioGroup>
                
                <TextView
                    android:id="@+id/tv_current_season"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Mùa hiện tại: ❄️ Mùa đông"
                    android:textSize="14sp"
                    android:textColor="?attr/colorPrimary"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"/>
                
                <!-- Dropdown chọn mùa (chỉ hiện khi chọn custom) -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layout_season_dropdown"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Chọn hiệu ứng"
                    android:visibility="gone">
                    
                    <AutoCompleteTextView
                        android:id="@+id/dropdown_season"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"
                        android:textSize="16sp"/>
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switch_confetti"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pháo giấy khi đặt hàng"
                android:textSize="18sp"
                android:padding="16dp"/>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switch_cart_animation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Animation thêm giỏ hàng"
                android:textSize="18sp"
                android:padding="16dp"/>


            <com.google.android.material.divider.MaterialDivider
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"/>

            <TextView
                style="@style/TextAppearance.Material3.LabelLarge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Khác"
                android:textColor="?attr/colorPrimary"
                android:paddingBottom="8dp"/>

            <TextView
                android:id="@+id/tv_about"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Giới thiệu"
                android:textSize="18sp"
                android:padding="16dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/tv_terms_of_use"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Điều khoản sử dụng"
                android:textSize="18sp"
                android:padding="16dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/tv_privacy_policy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Chính sách bảo mật"
                android:textSize="18sp"
                android:padding="16dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
