<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer glow -->
    <item>
        <shape android:shape="oval">
            <stroke
                android:width="3dp"
                android:color="#205C6BC0" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
    <!-- Inner glow -->
    <item
        android:left="4dp"
        android:top="4dp"
        android:right="4dp"
        android:bottom="4dp">
        <shape android:shape="oval">
            <stroke
                android:width="2dp"
                android:color="#405C6BC0" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</layer-list>
