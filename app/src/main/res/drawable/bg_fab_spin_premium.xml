<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Shadow layer -->
    <item android:bottom="2dp" android:left="2dp" android:right="2dp" android:top="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:endColor="#F57C00"
                android:centerColor="#FFB74D"
                android:startColor="#FFE0B2"
                android:type="linear" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <!-- Glow effect -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:endColor="#EF6C00"
                android:centerColor="#FFA726"
                android:startColor="#FFCC80"
                android:type="linear" />
            <corners android:radius="20dp" />
            <stroke
                android:width="1dp"
                android:color="#40FFFFFF" />
        </shape>
    </item>
</layer-list>
